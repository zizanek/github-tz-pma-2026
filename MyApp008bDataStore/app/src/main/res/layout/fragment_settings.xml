<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="24dp">

        <TextView android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:text="Herní profil" android:textSize="24sp" android:textStyle="bold"/>

        <EditText android:hint="Zadej herní přezdívku" android:id="@+id/etNickname" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:layout_width="match_parent"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHardcoreMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zapnout Hardcore režim"
            android:layout_marginBottom="24dp"/>

        <Button android:id="@+id/btnSave" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Uložit (DataStore)"/>

        <!-- Načítací kolečko je defaultně neviditelné -->
        <ProgressBar android:id="@+id/progressBar" android:visibility="invisible" android:layout_gravity="center" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:layout_width="wrap_content"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>